local function sendWebhookLog(title, desc)
    if webhookData.activeName == "" then return end
    local url = webhookData.saved[webhookData.activeName]
    if not url then return end
    
    local data = {
        ["embeds"] = {{
            ["title"] = title,
            ["description"] = desc,
            ["color"] = 5793266,
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%S")
        }}
    }
    local encoded = hs:JSONEncode(data)
    pcall(function()
        http_request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = encoded
        })
    end)
end

