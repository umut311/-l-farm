local function clkObj(o)
    if not o then return false end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(o.Activated) or {}) do c:Fire() end
            for _, c in ipairs(getconnections(o.MouseButton1Click) or {}) do c:Fire() end
        end
    end)
    pcall(function()
        local ap = o.AbsolutePosition
        local as = o.AbsoluteSize
        local is = gs:GetGuiInset()
        if as.X > 0 and as.Y > 0 then
            local x = ap.X + (as.X / 2)
            local y = ap.Y + (as.Y / 2) + is.Y
            vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.wait(0.15)
            vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
        end
    end)
end

local function isTrulyVisible(obj)
    local curr = obj
    while curr and curr ~= game and curr.Parent ~= game do
        if curr:IsA("GuiObject") and not curr.Visible then
            return false
        elseif curr:IsA("LayerCollector") and not curr.Enabled then
            return false
        end
        curr = curr.Parent
    end
    return true
end

local function checkEndScreen()
    local isDone = false
    local clickBtn = nil
    pcall(function()
        for _, obj in ipairs(pg:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                if obj.AbsolutePosition.X > 0 and obj.AbsoluteSize.X > 40 and obj.AbsoluteSize.Y > 10 then
                    if isTrulyVisible(obj) then
                        local txt = string.upper(obj.Text or "")
                        txt = string.gsub(txt, "^%s*(.-)%s*$", "%1")
                        
                        if string.find(txt, "BAŞARILI") then
                            isDone = true
                        end
                        
                        if string.find(txt, "ÜSSE") or string.find(txt, "USSE") or string.find(txt, "GERI DON") or string.find(txt, "GERİ DÖN") then
                            isDone = true
                            clickBtn = obj
                        end
                    end
                end
            end
        end
    end)
    return isDone, clickBtn
end

local function dLob()
    fLoad = true
    ignoredBots = {}
    matchStartTime = tick()
    pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>Operasyon Menüsü Açılıyor</font>" end)
    
    pcall(function()
        for _, o in ipairs(pg:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Visible then
                local txt = string.upper(o.Text or "")
                if string.find(txt, "TAMAM") or string.find(txt, "KAPAT") then
                    clkObj(o:IsA("GuiButton") and o or o.Parent)
                end
            end
        end
    end)

    pcall(function()
        local og = pg:FindFirstChild("Operasyon") or pg:FindFirstChild("Operation")
        if og then
            og.Enabled = true
            local o = og:FindFirstChild("Operasyon") or og:FindFirstChild("Frame")
            if o then o.Visible = true end
        end
    end)
    task.wait(0.5)
    pcall(function()
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("TextLabel") or o:IsA("TextButton") then
                local txt = string.upper(o.Text or "")
                if string.find(txt, "ÇÖL ŞEHRİ") or string.find(txt, "COL SEHRI") or o.Name == "Çöl Şehri" then
                    clkObj(o:IsA("GuiButton") and o or o.Parent)
                end
            end
        end
    end)
    task.wait(1)
    pcall(function()
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("TextLabel") or o:IsA("TextButton") then
                local txt = string.upper(o.Text or "")
                if string.find(txt, "BAŞLAT") or string.find(txt, "BASLAT") then
                    clkObj(o:IsA("GuiButton") and o or o.Parent)
                end
            end
        end
    end)
    task.wait(0.5)
    pcall(function()
        local bestBtn = nil
        local minPlr = 90
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("TextLabel") or o:IsA("TextButton") then
                local txt = o.Text or ""
                local c, m = string.match(txt, "(%d+)/(%d+)")
                if c and m then
                    local cur = tonumber(c)
                    local maxp = tonumber(m)
                    if cur and maxp and cur < 90 and cur < minPlr then
                        local ancestor = o.Parent
                        local foundKatil = nil
                        for _ = 1, 6 do
                            if ancestor and ancestor ~= pg then
                                for _, ch in ipairs(ancestor:GetDescendants()) do
                                    if (ch:IsA("TextButton") or ch:IsA("TextLabel")) then
                                        local chTxt = string.upper(ch.Text or "")
                                        if string.find(chTxt, "KATIL") and not string.find(chTxt, "OTO") then
                                            foundKatil = ch:IsA("GuiButton") and ch or ch.Parent
                                            break
                                        end
                                    end
                                end
                                if foundKatil then break end
                                ancestor = ancestor.Parent
                            else
                                break
                            end
                        end
                        if foundKatil then
                            minPlr = cur
                            bestBtn = foundKatil
                        end
                    end
                end
            end
        end
        if bestBtn then
            clkObj(bestBtn)
        end
    end)
end

local function pK()
    pcall(function()
        if sethiddenproperty then
            pcall(function() sethiddenproperty(lp, "SimulationRadius", 9999999) end)
            pcall(function() sethiddenproperty(lp, "MaxSimulationRadius", 9999999) end)
        end

        local c = lp.Character
        if not c then return end

        local botsToKill = {}
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Model") and o ~= c and not ignoredBots[o] then
                local h = o:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and not plrs:GetPlayerFromCharacter(o) then
                    table.insert(botsToKill, {M = o, H = h})
                end
            end
        end

        totalBotsInMap = #botsToKill + kBots

        if #botsToKill > 0 then
            task.wait(0.1) 
            for _, b in ipairs(botsToKill) do
                if b.H and b.H.Parent then
                    pcall(function() b.H:TakeDamage(99999) end)
                    b.H.Health = 0
                    
                    local hd = b.M:FindFirstChild("Head")
                    if hd then hd:Destroy() end
                    
                    b.M:BreakJoints()
                    
                    for _, desc in ipairs(b.M:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.CanCollide = false
                            desc.Transparency = 1
                        elseif desc:IsA("NumberValue") or desc:IsA("IntValue") then
                            local n = string.lower(desc.Name)
                            if n:find("health") or n:find("hp") or n:find("life") then
                                desc.Value = 0
                            end
                        end
                    end
                    
                    task.delay(0.2, function()
                        if b.H and b.H.Health > 0 then
                            ignoredBots[b.M] = true
                            pcall(function()
                                local rPart = b.M:FindFirstChild("HumanoidRootPart") or b.M.PrimaryPart
                                if rPart then rPart.CFrame = CFrame.new(0, -10000, 0) end
                                b.M:Destroy()
                            end)
                        end
                    end)
                end
            end
            kBots = kBots + #botsToKill
        end
    end)
end

local function tps(l)
    pcall(function()
        local c = lp.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            c.HumanoidRootPart.CFrame = l
            c.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
        end
    end)
end

local function dKill()
    if fLoad then
        mTime = tick()
        mStg = "WS"
        fLoad = false
        kBots = 0
        ignoredBots = {}
    end
    
    local c = lp.Character
    
    if c and c:FindFirstChildOfClass("Humanoid") and c:FindFirstChildOfClass("Humanoid").Sit then
        if tick() - mTime < 1.5 then
            pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>Helikopterde (1.5s)</font>" end)
            return
        end
        pcall(function() 
            c.Humanoid.Sit = false 
            c.Humanoid.Jump = true 
        end)
        pcall(function()
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hrp then
                local jnts = hrp:GetJoints()
                for i = 1, #jnts do
                    local w = jnts[i]
                    if w.ClassName == "Weld" or w.Name == "SeatWeld" then 
                        w:Destroy() 
                    end
                end
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 3, 0)
            end
        end)
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>Helikopterden İniyor</font>" end)
        return
    end

    if mStg ~= "WS" and mStg ~= "DN" then
        local over, eBtn = checkEndScreen()
        if over then
            mStg = "DN"
            if eBtn then
                clkObj(eBtn)
                if eBtn.Parent then clkObj(eBtn.Parent) end
            end
            return
        end
    end

    if mStg == "WS" then
        local e = tick() - mTime
        local kalan = 60 - math.floor(e)
        if kalan > 0 then
            pcall(function() fStatus.Text = string.format("Durum: <font color='#A0A0A0'>Savaş Bekleniyor: %ds</font>", kalan) end)
        else
            mStg = "TP1"
            sTmr = tick()
        end
        
    elseif mStg == "TP1" then
        tps(l1)
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>1. Bölge Temizleniyor</font>" end)
        pK()
        if tick() - sTmr >= 7.0 then
            mStg = "TP2"
            sTmr = tick()
        end

    elseif mStg == "TP2" then
        tps(l2)
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>2. Bölge Temizleniyor</font>" end)
        pK()
        if tick() - sTmr >= 9.0 then
            mStg = "TP3"
            sTmr = tick()
        end

    elseif mStg == "TP3" then
        tps(l3)
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>3. Bölge Temizleniyor</font>" end)
        pK()
        if tick() - sTmr >= 7.0 then
            mStg = "TP1_AGAIN"
            sTmr = tick()
        end

    elseif mStg == "TP1_AGAIN" then
        tps(l1)
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>1. Bölge Son Kontrol</font>" end)
        pK()
        if tick() - sTmr >= 7.0 then
            mStg = "WE"
            sTmr = tick()
        end

    elseif mStg == "WE" then
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>Çıkış Bekleniyor</font>" end)
        pK() 
        
        if tick() - mTime > 140 or tick() - sTmr > 12 then
            pcall(function()
                if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                    lp.Character.Humanoid.Health = 0
                end
            end)
            mStg = "DN"
            sTmr = tick()
            return
        end
        
    elseif mStg == "DN" then
        pcall(function() fStatus.Text = "Durum: <font color='#A0A0A0'>Lobiye Dönülüyor</font>" end)
        pcall(function()
            for _, obj in ipairs(pg:GetDescendants()) do
                if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible then
                    if obj.AbsolutePosition.X > 0 and obj.AbsoluteSize.X > 40 and obj.AbsoluteSize.Y > 10 then
                        if isTrulyVisible(obj) then
                            local txt = string.upper(obj.Text or "")
                            if string.find(txt, "ÜSSE") or string.find(txt, "USSE") or string.find(txt, "GERI DON") or string.find(txt, "GERİ DÖN") then
                                clkObj(obj)
                                if obj.Parent then clkObj(obj.Parent) end
                            end
                        end
                    end
                end
            end
        end)
    end
end

coroutine.wrap(function()
    while task.wait(0.5) do
        if not gui.Parent then break end
        if _G.VoidAutoFarm then
            if game.PlaceId == 3231515867 or game.PlaceId == 79691020115124 then
                dLob()
                task.wait(2.5) 
            else
                pcall(dKill)
            end
        end
        
        local elapsed = math.floor(tick() - matchStartTime)
        local hrs = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60
        
        pcall(function()
            fTotalBots.Text = "Toplam Bot: <font color='#FFFFFF'>" .. tostring(totalBotsInMap) .. "</font>"
            fKilledBots.Text = "Kesilen Bot: <font color='#FFFFFF'>" .. tostring(kBots) .. "</font>"
            fTimePassed.Text = string.format("Geçen Süre: <font color='#A0A0A0'>%02d:%02d:%02d</font>", hrs, mins, secs)
            
            if kBots > 0 then
                local avgTimePerBot = elapsed / kBots
                local remainingBots = totalBotsInMap - kBots
                if remainingBots < 0 then remainingBots = 0 end
                local remSecs = math.floor(remainingBots * avgTimePerBot)
                local rMins = math.floor(remSecs / 60)
                local rSecs = remSecs % 60
                fTimeRemain.Text = string.format("Tahmini Kalan: <font color='#A0A0A0'>%02d:%02d</font>", rMins, rSecs)
            else
                fTimeRemain.Text = "Tahmini Kalan: <font color='#A0A0A0'>Hesaplanıyor...</font>"
            end
        end)
    end
end)()
