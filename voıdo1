local function pK()
    pcall(function()
        if sethiddenproperty then
            pcall(function() sethiddenproperty(lp, "SimulationRadius", 9999999) end)
            pcall(function() sethiddenproperty(lp, "MaxSimulationRadius", 9999999) end)
        end

        local c = lp.Character
        if not c then return end

        local botsToKill = {}
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Model") and o ~= c and not ignoredBots[o] then
                local h = o:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and not plrs:GetPlayerFromCharacter(o) then
                    table.insert(botsToKill, {M = o, H = h})
                end
            end
        end

        if #botsToKill > 0 then
            task.wait(0.1) 
            for _, b in ipairs(botsToKill) do
                if b.H and b.H.Parent then
                    pcall(function() b.H:TakeDamage(99999) end)
                    b.H.Health = 0
                    
                    local hd = b.M:FindFirstChild("Head")
                    if hd then hd:Destroy() end
                    
                    b.M:BreakJoints()
                    
                    for _, desc in ipairs(b.M:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.CanCollide = false
                            desc.Transparency = 1
                        elseif desc:IsA("NumberValue") or desc:IsA("IntValue") then
                            local n = string.lower(desc.Name)
                            if n:find("health") or n:find("hp") or n:find("life") then
                                desc.Value = 0
                            end
                        end
                    end
                    
                    task.delay(0.2, function()
                        if b.H and b.H.Health > 0 then
                            ignoredBots[b.M] = true
                            pcall(function()
                                local rPart = b.M:FindFirstChild("HumanoidRootPart") or b.M.PrimaryPart
                                if rPart then rPart.CFrame = CFrame.new(0, -10000, 0) end
                                b.M:Destroy()
                            end)
                        end
                    end)
                end
            end
            kBots = kBots + #botsToKill
            updK(kBots)
        end
    end)
end

local function tps(l)
    pcall(function()
        local c = lp.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            c.HumanoidRootPart.CFrame = l
            c.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
        end
    end)
end

local function dKill()
    if fLoad then
        mTime = tick()
        mStg = "WS"
        fLoad = false
        kBots = 0
        ignoredBots = {}
    end
    
    local c = lp.Character
    
    -- OBFUSCATOR İÇİN YENİDEN YAZILMIŞ HELİKOPTERDEN İNME SİSTEMİ
    if c and c:FindFirstChildOfClass("Humanoid") and c:FindFirstChildOfClass("Humanoid").Sit then
        if tick() - mTime < 1.5 then
            updSt("Helikopterde (1.5s)")
            return
        end
        pcall(function() 
            c.Humanoid.Sit = false 
            c.Humanoid.Jump = true 
        end)
        pcall(function()
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hrp then
                local jnts = hrp:GetJoints()
                for i = 1, #jnts do
                    local w = jnts[i]
                    if w.ClassName == "Weld" or w.Name == "SeatWeld" then 
                        w:Destroy() 
                    end
                end
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 3, 0)
            end
        end)
        updSt("Helikopterden Iniliyor")
        return
    end

    if mStg ~= "WS" and mStg ~= "DN" then
        local over, eBtn = checkEndScreen()
        if over then
            mStg = "DN"
            if eBtn then
                clkObj(eBtn)
                if eBtn.Parent then clkObj(eBtn.Parent) end
            end
            return
        end
    end

    if mStg == "WS" then
        local e = tick() - mTime
        local kalan = 60 - math.floor(e)
        if kalan > 0 then
            updSt(string.format("Savas Icin Bekleniyor: %ds", kalan))
        else
            mStg = "TP1"
            sTmr = tick()
        end
        
    elseif mStg == "TP1" then
        tps(l1)
        updSt("1. Bolge Temizleniyor")
        pK()
        if tick() - sTmr >= 7.0 then
            mStg = "TP2"
            sTmr = tick()
        end

    elseif mStg == "TP2" then
        tps(l2)
        updSt("2. Bolge Temizleniyor")
        pK()
        if tick() - sTmr >= 9.0 then
            mStg = "TP3"
            sTmr = tick()
        end

    elseif mStg == "TP3" then
        tps(l3)
        updSt("3. Bolge Temizleniyor")
        pK()
        if tick() - sTmr >= 7.0 then
            mStg = "TP1_AGAIN"
            sTmr = tick()
        end

    elseif mStg == "TP1_AGAIN" then
        tps(l1)
        updSt("1. Bolge Son Kontrol")
        pK()
        if tick() - sTmr >= 7.0 then
            mStg = "WE"
            sTmr = tick()
        end

    elseif mStg == "WE" then
        updSt("Cikis Bekleniyor")
        pK() 
        
        if tick() - mTime > 140 or tick() - sTmr > 12 then
            pcall(function()
                if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                    lp.Character.Humanoid.Health = 0
                end
            end)
            mStg = "DN"
            sTmr = tick()
            return
        end
        
    elseif mStg == "DN" then
        updSt("Lobiye Donuluyor")
        pcall(function()
            for _, obj in ipairs(pg:GetDescendants()) do
                if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible then
                    if obj.AbsolutePosition.X > 0 and obj.AbsoluteSize.X > 40 and obj.AbsoluteSize.Y > 10 then
                        if isTrulyVisible(obj) then
                            local txt = string.upper(obj.Text or "")
                            if string.find(txt, "ÜSSE") or string.find(txt, "USSE") or string.find(txt, "GERI DON") or string.find(txt, "GERİ DÖN") then
                                clkObj(obj)
                                if obj.Parent then clkObj(obj.Parent) end
                            end
                        end
                    end
                end
            end
        end)
    end
end

