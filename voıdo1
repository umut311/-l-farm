local function clkObj(o)
    if not o then return false end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(o.Activated) or {}) do c:Fire() end
            for _, c in ipairs(getconnections(o.MouseButton1Click) or {}) do c:Fire() end
        end
    end)
    pcall(function()
        local ap = o.AbsolutePosition
        local as = o.AbsoluteSize
        local is = gs:GetGuiInset()
        if as.X > 0 and as.Y > 0 then
            local x = ap.X + (as.X / 2)
            local y = ap.Y + (as.Y / 2) + is.Y
            vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.wait(0.15)
            vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
        end
    end)
end

local function isTrulyVisible(obj)
    local curr = obj
    while curr and curr ~= game and curr.Parent ~= game do
        if curr:IsA("GuiObject") and not curr.Visible then
            return false
        elseif curr:IsA("LayerCollector") and not curr.Enabled then
            return false
        end
        curr = curr.Parent
    end
    return true
end

local function checkEndScreen()
    local isDone = false
    local clickBtn = nil
    pcall(function()
        for _, obj in ipairs(pg:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                if obj.AbsolutePosition.X > 0 and obj.AbsoluteSize.X > 40 and obj.AbsoluteSize.Y > 10 then
                    if isTrulyVisible(obj) then
                        local txt = string.upper(obj.Text or "")
                        txt = string.gsub(txt, "^%s*(.-)%s*$", "%1")
                        
                        if string.find(txt, "BAŞARILI") then
                            isDone = true
                        end
                        
                        if string.find(txt, "ÜSSE") or string.find(txt, "USSE") or string.find(txt, "GERI DON") or string.find(txt, "GERİ DÖN") then
                            isDone = true
                            clickBtn = obj
                        end
                    end
                end
            end
        end
    end)
    return isDone, clickBtn
end

